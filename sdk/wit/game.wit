package tabletty:game@0.1.0;

// The types live inside the world rather than in an `interface`: a world that
// `use`s an interface imports it, and even a types-only import would show up in
// `game-imports`.
//
// `///` comments here become the rustdoc of the types tabletty-sdk re-exports.

/// A game plugin. Everything here is `export`; there is deliberately no `import`.
/// A component with zero imports cannot reach a clock, entropy, the filesystem or
/// the network, so determinism is a property of the module rather than a rule.
world game-plugin {
  type player-id = u8;
  /// Opaque, plugin-owned (postcard inside).
  type state     = list<u8>;
  /// Opaque, plugin-owned (postcard inside).
  type action    = list<u8>;

  record manifest {
    /// Stable identifier used for discovery, e.g. `"love-letter"`.
    id:          string,
    /// Shown to humans, e.g. `"Love Letter"`.
    name:        string,
    version:     string,
    min-players: u8,
    max-players: u8,
    summary:     string,
  }

  record player { id: player-id, name: string }

  record init-ctx {
    players: list<player>,
    /// 32 bytes from commit–reveal. The only entropy a game ever gets.
    seed:    list<u8>,
    /// Per-game settings from the lobby.
    options: list<tuple<string, string>>,
  }

  record action-spec {
    /// Stable key for logs, tests and golden transcripts.
    id:      string,
    /// What the TUI shows.
    label:   string,
    /// Submitted verbatim; the host checks it byte-for-byte against what it offered.
    payload: action,
    enabled: bool,
    /// Why the action is disabled, shown as a hint.
    reason:  option<string>,
  }

  /// The only way a game affects anything outside its own state. There are no
  /// host callbacks.
  variant effect {
    public-log(string),
    private-log(private-msg),
    set-timer(timer),
    cancel-timer(string),
    game-over(list<outcome>),
  }

  record private-msg { to: player-id, text: string }
  record timer       { id: string, seconds: u32 }
  record outcome     { player: player-id, rank: u8, score: s32, note: string }

  /// The declarative render tree. Games emit it; the TUI draws it.
  record view {
    title:  string,
    /// Key/value pairs such as `("Turn", "Alice")`.
    status: list<tuple<string, string>>,
    zones:  list<zone>,
    log:    list<log-line>,
    prompt: option<prompt>,
  }

  record zone { label: string, layout: layout, items: list<item> }
  variant layout {
    row,
    /// Items fill rows of this many columns, left to right.
    grid(u8),
    stack,
    /// A hand of cards: a row that overlaps its items when space is short.
    hand,
    /// A deck or discard pile: only the last item is drawn, with how many there are.
    pile,
  }

  record item {
    face:       face,
    label:      string,
    sublabel:   string,
    badges:     list<string>,
    /// Makes the item a click/enter target.
    selectable: option<action-spec>,
    /// Presentation hints. Absent means the renderer picks from the zone's layout,
    /// and a renderer may override them, e.g. to fit a small screen.
    shape:      option<shape>,
    size:       option<size>,
    tone:       option<tone>,
  }

  variant face {
    /// An art key: one of the game's `art`, or else shown as the key itself.
    up(string),
    down,
    empty,
    /// A die showing this many pips; the renderer draws it.
    die(u8),
    /// Progress along a track, e.g. 3 of 7 tokens; the renderer draws it.
    track(track),
  }

  record track { filled: u32, total: u32 }

  /// How an item is framed.
  enum shape { plain, card, tile, token, icon }
  enum size { small, medium, large }

  /// A semantic colour. Each renderer maps it onto its own theme, so games never
  /// pick RGB values that clash or vanish on a dark background.
  variant tone { neutral, accent, good, bad, player(player-id) }

  /// Art the game draws itself, declared once and referred to by key from `face.up`.
  /// Renderers use the best rendition they can show, falling back to `label`.
  record art {
    key:   string,
    /// Accessible name, and the fallback when nothing else fits.
    label: string,
    /// One or two single-width characters for tight spaces. Renderers may drop
    /// anything wider.
    glyph: option<string>,
    /// The full picture. Draw shapes only: text needs fonts a renderer may not have,
    /// and external references (`<image href>`) are never loaded.
    svg:   option<string>,
    tone:  option<tone>,
  }

  record log-line { text: string, kind: log-kind }
  enum log-kind { public, private, system }

  record prompt {
    text:             string,
    choices:          list<action-spec>,
    /// Display only; the real clock is a timer effect.
    deadline-seconds: option<u32>,
  }

  export manifest: func() -> manifest;
  export init:     func(ctx: init-ctx) -> state;
  export actions:  func(st: state, p: player-id) -> list<action-spec>;
  export apply:    func(st: state, p: player-id, a: action)
                     -> result<tuple<state, list<effect>>, string>;
  export view:     func(st: state, p: option<player-id>) -> view;
  export art:      func() -> list<art>;
}
