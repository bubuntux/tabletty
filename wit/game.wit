package tabletty:game@0.1.0;

// The types live inside the world rather than in an `interface`: a world that
// `use`s an interface imports it, and even a types-only import would show up in
// `game-imports`.
//
// `///` comments here become the rustdoc of the types tabletty-sdk re-exports.

/// A game plugin. Everything here is `export`; there is deliberately no `import`.
/// A component with zero imports cannot reach a clock, entropy, the filesystem or
/// the network, so determinism is a property of the module rather than a rule.
world game-plugin {
  type player-id = u8;
  /// Opaque, plugin-owned (postcard inside).
  type state     = list<u8>;
  /// Opaque, plugin-owned (postcard inside).
  type action    = list<u8>;

  record manifest {
    /// Stable identifier used for discovery, e.g. `"love-letter"`.
    id:          string,
    /// Shown to humans, e.g. `"Love Letter"`.
    name:        string,
    version:     string,
    min-players: u8,
    max-players: u8,
    summary:     string,
  }

  record player { id: player-id, name: string }

  record init-ctx {
    players: list<player>,
    /// 32 bytes from commit–reveal. The only entropy a game ever gets.
    seed:    list<u8>,
    /// Per-game settings from the lobby.
    options: list<tuple<string, string>>,
  }

  record action-spec {
    /// Stable key for logs, tests and golden transcripts.
    id:      string,
    /// What the TUI shows.
    label:   string,
    /// Submitted verbatim; the host checks it byte-for-byte against what it offered.
    payload: action,
    enabled: bool,
    /// Why the action is disabled, shown as a hint.
    reason:  option<string>,
  }

  /// The only way a game affects anything outside its own state. There are no
  /// host callbacks.
  variant effect {
    public-log(string),
    private-log(private-msg),
    set-timer(timer),
    cancel-timer(string),
    game-over(list<outcome>),
  }

  record private-msg { to: player-id, text: string }
  record timer       { id: string, seconds: u32 }
  record outcome     { player: player-id, rank: u8, score: s32, note: string }

  /// The declarative render tree. Games emit it; the TUI draws it.
  record view {
    title:  string,
    /// Key/value pairs such as `("Turn", "Alice")`.
    status: list<tuple<string, string>>,
    zones:  list<zone>,
    log:    list<log-line>,
    prompt: option<prompt>,
  }

  record zone { label: string, layout: layout, items: list<item> }
  enum layout { row, grid, stack }

  record item {
    face:       face,
    label:      string,
    sublabel:   string,
    badges:     list<string>,
    /// Makes the item a click/enter target.
    selectable: option<action-spec>,
  }

  variant face {
    /// An art key, e.g. `"guard"`. The renderer owns the glyphs.
    up(string),
    down,
    empty,
  }

  record log-line { text: string, kind: log-kind }
  enum log-kind { public, private, system }

  record prompt {
    text:             string,
    choices:          list<action-spec>,
    /// Display only; the real clock is a timer effect.
    deadline-seconds: option<u32>,
  }

  export manifest: func() -> manifest;
  export init:     func(ctx: init-ctx) -> state;
  export actions:  func(st: state, p: player-id) -> list<action-spec>;
  export apply:    func(st: state, p: player-id, a: action)
                     -> result<tuple<state, list<effect>>, string>;
  export view:     func(st: state, p: option<player-id>) -> view;
}
